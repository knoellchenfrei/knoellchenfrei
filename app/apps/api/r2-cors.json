{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://knoellchenfrei.pages.dev",
          "https://knoellchenfrei.de",
          "https://www.knoellchenfrei.de",
          "http://localhost:5173",
          "http://localhost:4173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "if-match"]
      },
      "exposeHeaders": ["etag", "content-range", "content-length", "accept-ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
